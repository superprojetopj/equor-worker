PORT=3000
NODE_ENV=development

# Logs (arquivo + stdout)
LOG_FILE=logs/equor-worker.log
# LOG_LEVEL=info

# Backend PHP (Yii2)
BACKEND_URL=http://localhost:8081
# Paths dos endpoints (opcionais, defaults abaixo)
# BACKEND_AI_GENERATE_PATH=/worker/{processDocumentId}/ai-generate-task-data
# BACKEND_AI_GENERATE_RESULT_PATH=/worker/{processDocumentId}/ai-generate-result
# BACKEND_SIGN_TASK_DATA_PATH=/worker/{processDocumentId}/sign-task-data
# BACKEND_SIGN_TASK_RESULT_PATH=/worker/{processDocumentId}/sign-result

# Auth — generate with `openssl rand -hex 32`. Min 32 chars; left empty on
# purpose so startup fails loudly instead of running on a placeholder everyone
# with the repo already knows.
WORKER_SECRET=

# Google Cloud Storage
GCS_BUCKET_NAME=equor-bucket
GOOGLE_APPLICATION_CREDENTIALS=./src/config/keys/your-gcs-key.json

# AI Provider: 'claude' ou 'gemini' (default: claude)
AI_PROVIDER=claude

# Anthropic (obrigatório se AI_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini (obrigatório se AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# Contraktor
CONTRAKTOR_API_URL=https://api-sandbox.contraktor.com.br/api
CONTRAKTOR_API_TOKEN=your-contraktor-token-here
